{
  "name": "genesis-compliance-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "cd apps/api && npm install && cd ../../apps/web && npm install && npm run build",
    "build:packages": "npm run build --workspaces --if-present"
  },
